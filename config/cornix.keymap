/*
 * Cornix LP keymap adapted from the user's BLE configuration.
 * Bluetooth profile controls and BLE-only helper dependencies are omitted
 * for the ESB-only build.
 *
 * SPDX-License-Identifier: MIT
 */

#define HM_TAPPING_TERM 250
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <125>;
            flavor = "balanced";
            quick-tap-ms = <125>;
        };

        Rsft_td: Rsft_td {
            compatible = "zmk,behavior-tap-dance";
            label = "Rsft_td";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&ht RSHIFT SLASH>, <&ht QMARK QMARK>;
        };

        Lalt_td: Lalt_td {
            compatible = "zmk,behavior-tap-dance";
            label = "LALT_TD";
            #binding-cells = <0>;
            bindings = <&ht LALT Y>, <&lt 1 LALT>;

            tapping-term-ms = <150>;
        };

        Lgui_td: Lgui_td {
            compatible = "zmk,behavior-tap-dance";
            label = "LGUI_TD";
            #binding-cells = <0>;
            bindings = <&ht LGUI LGUI>, <&lt 2 LGUI>;

            tapping-term-ms = <200>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            bindings = <
&kp TAB     &kp Q  &kp W  &kp E     &kp R      &kp T                                    &kp Y    &kp U      &kp I       &kp O     &kp P               &kp BACKSPACE
&kp LSHIFT  &kp A  &kp S  &kp D     &kp F      &kp G                                    &kp H    &kp J      &kp K       &kp L     &ht APOS SEMICOLON  &kp ENTER
&kp LCTRL   &kp Z  &kp X  &kp C     &kp V      &kp B     &lt 1 LG(LC(V))  &kp C_MUTE    &kp N    &kp M      &kp COMMA   &kp DOT   &kp UP              &Rsft_td
&none       &none  &none  &Lgui_td  &kp SPACE  &Lalt_td                                 &lt 1 B  &kp SPACE  &lt 2 RALT  &kp LEFT  &kp DOWN            &kp RIGHT
            >;

            sensor-bindings =
                <&inc_dec_kp (LC(TAB)) LC(LS(TAB))>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_num_layer {
            bindings = <
&none       &kp EXCLAMATION  &kp AT_SIGN   &kp POUND             &none                  &none                &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp N7  &kp N8  &kp N9  &trans
&kp LSHIFT  &kp DOLLAR       &kp PERCENT   &kp CARET             &none                  &none                &kp MINUS         &kp EQUAL          &kp N4  &kp N5  &kp N6  &none
&none       &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none  &none  &mo 3  &kp DOT           &kp N0             &kp N1  &kp N2  &kp N3  &kp RSHFT
&none       &none            &none         &none                 &kp SPACE              &none                &none             &kp SPACE          &none   &none   &none   &none
            >;

            label = "Sym/Num";
            sensor-bindings =
                <&inc_dec_kp (LC(LS(T))) LC(W)>,
                <&inc_dec_kp PERIOD COMMA>;
        };

        fn_macro_layer {
            bindings = <
&kp ESC    &kp F1  &kp F2   &kp F3   &kp F4   &none                &none  &none  &none            &none        &none          &kp DEL
&kp TILDE  &kp F5  &kp F6   &kp F7   &kp F8   &none                &none  &none  &kp LC(LS(T))    &kp LC(W)    &none          &none
&kp GRAVE  &kp F9  &kp F10  &kp F11  &kp F12  &none  &none  &none  &none  &none  &kp LC(LS(TAB))  &kp LC(TAB)  &kp PAGE_UP    &kp RSHIFT
&none      &none   &none    &none    &none    &none                &none  &none  &none            &kp HOME     &kp PAGE_DOWN  &kp END
            >;

            label = "Fn/Macro";
        };

        Debug_layer {
            display-name = "Debug";

            bindings = <
&none  &none  &none  &none  &none  &none                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
